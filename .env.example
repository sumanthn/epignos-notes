# Public URL used for origin validation and generated links.
APP_BASE_URL=http://localhost:3000

# Use the existing epignos_app account. Never commit the real value.
MONGODB_URI=mongodb://username:password@127.0.0.1:27017/epignos_dev?authSource=epignos_dev
MONGODB_DB=epignos_dev

# Development can bypass verification until email delivery is implemented.
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# true requires HTTPS and uses the __Host- cookie prefix.
COOKIE_SECURE=false

# HMAC secret used for privacy-preserving request identifiers.
AUTH_HMAC_SECRET=replace-with-at-least-32-random-bytes
